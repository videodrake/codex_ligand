#!/bin/bash
#PBS -q workq
#PBS -N Pyrosetta
#PBS -l nodes=node05:ppn=16
#PBS -l walltime=999:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/pbs_v1.o
#PBS -e ${PBS_O_WORKDIR}/pbs_v1.e

cd $PBS_O_WORKDIR
set -x

echo ">>> Working Directory: $(pwd)"

# Config file selection
# Default: config.ini | Override: qsub -v CONFIG_FILE=config_20k.ini run_v1.pbs
CONFIG_FILE="${CONFIG_FILE:-config.ini}"

# Log files
LOG="pipeline.log"
rm -f "$LOG"

echo ">>> Config: $CONFIG_FILE" | tee -a "$LOG"
echo ">>> Logs: $LOG (progress) | worker_debug.log (debug)" | tee -a "$LOG"

# Activate Environment (source conda.sh directly for non-interactive PBS shells)
source /usr/local/anaconda/3/2023.09/etc/profile.d/conda.sh
conda activate pyrosetta
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export PYTHONIOENCODING=utf-8

echo ">>> Environment activated." | tee -a "$LOG"
which python | tee -a "$LOG"
python -c "import sys; print(sys.version)" | tee -a "$LOG"
python -c "import pyrosetta; print('PyRosetta imported successfully')" | tee -a "$LOG"

# Check Config
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: $CONFIG_FILE missing in $(pwd)!" | tee -a "$LOG"
    exit 1
fi

echo ">>> Pipeline Started with $CONFIG_FILE..." | tee -a "$LOG"

# Loop through all PDBs in input_PDB folder
for INPUT_PATH in input_PDB/*.pdb
do
    if [ ! -e "$INPUT_PATH" ]; then
        echo "No PDB files found in input_PDB folder. Exiting loop." | tee -a "$LOG"
        break
    fi

    echo "Processing: $INPUT_PATH" | tee -a "$LOG"

    python pipeline_manager.py "$CONFIG_FILE" "$INPUT_PATH" >> "$LOG" 2>&1

    if [ $? -ne 0 ]; then
        echo "Python script failed for $INPUT_PATH. Check $LOG for details." | tee -a "$LOG"
    else
        echo "Done processing $INPUT_PATH" | tee -a "$LOG"
    fi
done

echo ">>> All Complete." | tee -a "$LOG"
