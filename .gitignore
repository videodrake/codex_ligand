output/

# Fresh workflow run outputs
fresh/runs/*
!fresh/runs/.gitkeep

# Normalized/generated data
fresh/data/normalized/*
!fresh/data/normalized/.gitkeep

# Confidential ligand structures and private mappings
fresh/data/raw/ligands/*
