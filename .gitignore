!fresh/data/raw/ligands/README.md
fresh/data/private/*
fresh/data/private/**
!fresh/data/private/.gitkeep
!fresh/data/private/README.md
fresh/runs/*/phase3_compounds/ligands/*
fresh/runs/*/phase3_compounds/ligands/**
