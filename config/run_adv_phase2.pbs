#!/bin/bash
#PBS -q workq
#PBS -N adv_phase2
#PBS -l nodes=node05:ppn=32
#PBS -l walltime=24:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/adv_phase2.o
#PBS -e ${PBS_O_WORKDIR}/adv_phase2.e

# ============================================================
# Advanced Pipeline Phase 2: Pocket Analysis (TG 2.0~2.7)
#
# Prerequisite: adv-phase1 complete (phase1_downstream_patch_reference.csv)
# Requires: fpocket and/or P2Rank installed on the server.
#
# Usage:
#   qsub config/run_adv_phase2.pbs
#   qsub -W depend=afterok:<adv_phase1_job> config/run_adv_phase2.pbs
# ============================================================

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

python run_production.py \
  --lane adv-phase2 \
  --allocated-cpus "${PBS_NP:-32}"
