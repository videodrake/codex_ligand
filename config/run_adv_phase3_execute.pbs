#!/bin/bash
#PBS -q workq
#PBS -N adv_phase3_exec
#PBS -l nodes=node05:ppn=32
#PBS -l walltime=08:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/adv_phase3_execute.o
#PBS -e ${PBS_O_WORKDIR}/adv_phase3_execute.e

# ============================================================
# Advanced Pipeline Phase 3: Focused Docking Execution (TG 3.3)
#
# Runs one round of budget-aware Vina focused docking.
# Requires: Vina installed, adv-phase3-setup complete.
#
# Usage (ROUND is required):
#   qsub -v ROUND=0 config/run_adv_phase3_execute.pbs
#   qsub -v ROUND=1 -W depend=afterok:<round0_job> config/run_adv_phase3_execute.pbs
#   qsub -v ROUND=2 -W depend=afterok:<round1_job> config/run_adv_phase3_execute.pbs
# ============================================================

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

ROUND="${ROUND:?ROUND is required, e.g. 0}"

# --seed is reused as round selector for adv-phase3-execute lane
python run_production.py \
  --lane adv-phase3-execute \
  --seed "$ROUND" \
  --allocated-cpus "${PBS_NP:-32}"
