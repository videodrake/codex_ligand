#!/bin/bash
#PBS -q workq
#PBS -N finalize
#PBS -l nodes=node05:ppn=2
#PBS -l walltime=01:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/finalize.o
#PBS -e ${PBS_O_WORKDIR}/finalize.e

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

python run_production.py \
  --lane finalize \
  --allocated-cpus "${PBS_NP:-2}"
