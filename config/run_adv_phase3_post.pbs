#PBS -e ${PBS_O_WORKDIR}/adv_phase3_post.e

# ============================================================
# Advanced Pipeline Phase 3: Post-Docking Analysis (TG 3.4~3.6)
#
# Prerequisite: All Phase 3 execution rounds complete.
# No Vina required — analysis only.
#
# Usage:
#   qsub config/run_adv_phase3_post.pbs
#   qsub -W depend=afterok:<last_round_job> config/run_adv_phase3_post.pbs
# ============================================================

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

python run_production.py \
  --lane adv-phase3-post \
  --allocated-cpus "${PBS_NP:-4}"
