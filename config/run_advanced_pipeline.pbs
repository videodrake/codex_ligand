#!/bin/bash
#PBS -q workq
#PBS -N ADV_pipeline
#PBS -l nodes=node05:ppn=2
#PBS -l walltime=01:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/adv_pipeline.o
#PBS -e ${PBS_O_WORKDIR}/adv_pipeline.e

# ============================================================
# Advanced PPI-First Pipeline — PBS Dependency Chain Orchestrator
#
# 이 스크립트는 qsub로 제출되면 내부에서 각 Phase를 의존성 체인으로
# 자동 제출합니다. 자체는 가벼운 제출 작업만 수행 (ppn=2, ~수 분).
#
# 전제 조건: Workflow A Phase 2 (PPI docking) 완료
#   i.e., output/workflow_a/phase2_ppi_docking/*/prod_seed*/seed_complete.json 존재
#
# Usage:
#   qsub config/run_advanced_pipeline.pbs
#   qsub -v ADV_FROM=2 config/run_advanced_pipeline.pbs        # Phase 2부터
#   qsub -v ADV_ROUNDS=5 config/run_advanced_pipeline.pbs      # 5 rounds
#   qsub -v ADV_FROM=3,ADV_ROUNDS=2 config/run_advanced_pipeline.pbs
#
# 개별 Phase만 수동 제출:
#   qsub config/run_adv_phase1.pbs
#   qsub -W depend=afterok:<job> config/run_adv_phase2.pbs
#   qsub -W depend=afterok:<job> config/run_adv_phase3_setup.pbs
#   qsub -v ROUND=0 -W depend=afterok:<job> config/run_adv_phase3_execute.pbs
#   qsub -v ROUND=1 -W depend=afterok:<job> config/run_adv_phase3_execute.pbs
#   qsub -v ROUND=2 -W depend=afterok:<job> config/run_adv_phase3_execute.pbs
#   qsub -W depend=afterok:<job> config/run_adv_phase3_post.pbs
#   qsub -W depend=afterok:<job> config/run_adv_phase4.pbs
# ============================================================

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

ADV_FROM=${ADV_FROM:-1}
ADV_ROUNDS=${ADV_ROUNDS:-3}

echo "============================================"
echo "  Advanced PPI-First Pipeline Orchestrator"
echo "  Started: $(date)"
echo "  Node: $(hostname)"
echo "  From phase: $ADV_FROM"
echo "  Rounds:     $ADV_ROUNDS"
echo "============================================"
echo ""

PREV_JOB=""

# AC-6.2: Run precheck with Workflow B tool validation before pipeline
echo "--- Precheck: Workflow B tool validation ---"
CHECK_WORKFLOW_B=1 bash "${PBS_O_WORKDIR}/scripts/run_pre_qsub_checks.sh" || {
    echo "PRECHECK FAILED — aborting pipeline submission."
    exit 1
}
echo ""

# Helper: extract numeric job ID from qsub output
get_job_id() {
    echo "$1" | grep -oP '^\d+(\.\S+)?' | head -1
}

# H-3: PBS job chain 로그 — 디버깅용 job ID 기록
JOB_LOG="${PBS_O_WORKDIR}/output/workflow_a/logs/pbs_job_chain.log"
mkdir -p "$(dirname "$JOB_LOG")"
log_job() {
    local lane_name="$1"
    local job_id="$2"
    local depends_on="${3:-none}"
    echo "$(date '+%Y-%m-%d %H:%M:%S') | ${lane_name} | ${job_id} | depends_on=${depends_on}" >> "$JOB_LOG"
}
echo "--- Job chain log: $JOB_LOG ---"
echo "$(date '+%Y-%m-%d %H:%M:%S') | === Pipeline submission start (FROM=$ADV_FROM, ROUNDS=$ADV_ROUNDS) ===" >> "$JOB_LOG"

# --- Phase 1: PPI Analysis ---
if [ "$ADV_FROM" -le 1 ]; then
    ADV1=$(qsub config/run_adv_phase1.pbs)
    PREV_JOB=$(get_job_id "$ADV1")
    echo "[adv-phase1] $ADV1"
    log_job "adv-phase1" "$PREV_JOB" "none"
fi

# --- Phase 2: Pocket Analysis ---
if [ "$ADV_FROM" -le 2 ]; then
    DEP_FOR_2="${PREV_JOB:-none}"
    if [ -n "$PREV_JOB" ]; then
        ADV2=$(qsub -W depend=afterok:"$PREV_JOB" config/run_adv_phase2.pbs)
    else
        ADV2=$(qsub config/run_adv_phase2.pbs)
    fi
    PREV_JOB=$(get_job_id "$ADV2")
    echo "[adv-phase2] $ADV2 (after $DEP_FOR_2)"
    log_job "adv-phase2" "$PREV_JOB" "$DEP_FOR_2"
fi

# --- Phase 3 Setup ---
if [ "$ADV_FROM" -le 3 ]; then
    DEP_FOR_3S="${PREV_JOB:-none}"
    if [ -n "$PREV_JOB" ]; then
        ADV3S=$(qsub -W depend=afterok:"$PREV_JOB" config/run_adv_phase3_setup.pbs)
    else
        ADV3S=$(qsub config/run_adv_phase3_setup.pbs)
    fi
    PREV_JOB=$(get_job_id "$ADV3S")
    echo "[adv-phase3-setup] $ADV3S"
    log_job "adv-phase3-setup" "$PREV_JOB" "$DEP_FOR_3S"

    # --- Phase 3 Execute (round by round, sequential) ---
    for ROUND in $(seq 0 $((ADV_ROUNDS - 1))); do
        DEP_FOR_3E="$PREV_JOB"
        ADV3E=$(qsub -W depend=afterok:"$PREV_JOB" -v ROUND="$ROUND" config/run_adv_phase3_execute.pbs)
        PREV_JOB=$(get_job_id "$ADV3E")
        echo "[adv-phase3-execute round $ROUND] $ADV3E"
        log_job "adv-phase3-execute-round${ROUND}" "$PREV_JOB" "$DEP_FOR_3E"
    done

    # --- Phase 3 Post ---
    DEP_FOR_3P="$PREV_JOB"
    ADV3P=$(qsub -W depend=afterok:"$PREV_JOB" config/run_adv_phase3_post.pbs)
    PREV_JOB=$(get_job_id "$ADV3P")
    echo "[adv-phase3-post] $ADV3P"
    log_job "adv-phase3-post" "$PREV_JOB" "$DEP_FOR_3P"
fi

# --- Phase 4: Perturbation Scoring ---
if [ "$ADV_FROM" -le 4 ]; then
    DEP_FOR_4="${PREV_JOB:-none}"
    if [ -n "$PREV_JOB" ]; then
        ADV4=$(qsub -W depend=afterok:"$PREV_JOB" config/run_adv_phase4.pbs)
    else
        ADV4=$(qsub config/run_adv_phase4.pbs)
    fi
    ADV4_ID=$(get_job_id "$ADV4")
    echo "[adv-phase4] $ADV4"
    log_job "adv-phase4" "$ADV4_ID" "$DEP_FOR_4"
fi

echo ""
echo "============================================"
echo "  All jobs submitted. Monitor with: qstat"
echo "  Finished: $(date)"
echo "============================================"
