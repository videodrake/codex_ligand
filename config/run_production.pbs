#!/bin/bash
#PBS -q workq
#PBS -N PROD_all
#PBS -l nodes=node05:ppn=32
#PBS -l walltime=999:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/production.o
#PBS -e ${PBS_O_WORKDIR}/production.e

# ============================================================
# EGFR-MYO1D Production Pipeline (PBS)
# Legacy compatibility wrapper.
#
# Recommended production scheduling now uses the lane-specific PBS wrappers:
#   - config/run_vina_cpu.pbs
#   - config/run_ppi_state_seed.pbs
#   - config/run_ppi_postprocess.pbs
#   - config/run_vina_postprocess.pbs
#   - config/run_finalize.pbs
#
# Recommended safe submission flow:
#   PRECHECK_JOB=$(qsub config/run_pre_qsub_checks.pbs)
#   qsub -W depend=afterok:${PRECHECK_JOB} config/run_production.pbs
#
# Direct submission examples:
#   qsub config/run_production.pbs
#   qsub -v MODE=force config/run_production.pbs
#   qsub -v MODE=from,FROM=4 config/run_production.pbs
#   qsub -v MODE=status config/run_production.pbs
#   qsub -v MODE=vina-only config/run_production.pbs
#   qsub -v MODE=ppi-only config/run_production.pbs
#   qsub -v MODE=post-only config/run_production.pbs
#
# Explicit guard bypass (use intentionally):
#   qsub -v SKIP_PRECHECK_GUARD=1 config/run_production.pbs
# ============================================================

cd $PBS_O_WORKDIR

source ~/.bashrc
conda activate pyrosetta

# Defaults
MODE=${MODE:-auto}
FROM=${FROM:-0}
SKIP_PRECHECK_GUARD=${SKIP_PRECHECK_GUARD:-0}
PRECHECK_STATUS_FILE="${PBS_O_WORKDIR}/output/precheck/last_pass.json"

echo "============================================"
echo "  EGFR-MYO1D Production Pipeline"
echo "  Vina(project-config driven blind discovery) + PPI(seed0)"
echo "  Started: $(date)"
echo "  Node: $(hostname)"
echo "  Cores: $(nproc)"
echo "  MODE: $MODE"
echo "  FROM: $FROM"
echo "  PRECHECK_STATUS_FILE: $PRECHECK_STATUS_FILE"
echo "============================================"

# Route by mode
if [[ "$MODE" != "status" && "$SKIP_PRECHECK_GUARD" != "1" ]]; then
    python scripts/precheck_guard.py \
        --workdir "$PBS_O_WORKDIR" \
        --mode "$MODE" \
        --skip-precheck-guard "$SKIP_PRECHECK_GUARD" || exit 1
fi

case "$MODE" in
    force)
        python run_production.py --force
        ;;
    from)
        python run_production.py --from "$FROM"
        ;;
    status)
        python run_production.py --status
        ;;
    vina-only)
        python run_production.py --only 1,4,5,6,7
        ;;
    ppi-only)
        python run_production.py --only 2,3
        ;;
    post-only)
        python run_production.py --from 4
        ;;
    auto|*)
        python run_production.py
        ;;
esac

echo ""
echo "============================================"
echo "  Finished: $(date)"
echo "============================================"
