#!/bin/bash
#PBS -q workq
#PBS -N vina_cpu
#PBS -l nodes=node05:ppn=24
#PBS -l walltime=06:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/vina_cpu.o
#PBS -e ${PBS_O_WORKDIR}/vina_cpu.e

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

python run_production.py \
  --lane vina-cpu \
  --allocated-cpus "${PBS_NP:-24}" \
  --engine cpu-vina
