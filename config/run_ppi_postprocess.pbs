#!/bin/bash
#PBS -q workq
#PBS -N ppi_post
#PBS -l nodes=node05:ppn=4
#PBS -l walltime=02:00:00
#PBS -V
#PBS -o ${PBS_O_WORKDIR}/ppi_postprocess.o
#PBS -e ${PBS_O_WORKDIR}/ppi_postprocess.e

set -eo pipefail

cd "$PBS_O_WORKDIR"
source ~/.bashrc
conda activate pyrosetta

python run_production.py \
  --lane ppi-post \
  --allocated-cpus "${PBS_NP:-4}"
